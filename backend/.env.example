# Backend Server Configuration
PORT=4000
NODE_ENV=development

# LLM API Configuration
# Optional: Provide Google Gemini API Key or compatible LLM provider key
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Android & API Security
# Token required in header x-api-token for physical device requests (optional in dev)
API_SECRET_KEY=dev_secret_screening_token_2026

# Fallback & Response Deadlines (milliseconds)
# Android telecom service has a ~5s deadline; backend must reply within this budget
LLM_TIMEOUT_MS=2200
FAST_RULES_TIMEOUT_MS=100
