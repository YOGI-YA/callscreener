# Backend Server Configuration
PORT=4000
NODE_ENV=development

# LLM Provider: 'ollama' | 'gemini' | 'local_heuristic'
LLM_PROVIDER=ollama

# Option A: Local Physical Model (Ollama) - 100% Free & Private (No API Key)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# Option B: Cloud Gemini API Key (Optional alternative)
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Android & API Security
# Token required in header x-api-token for physical device requests (optional in dev)
API_SECRET_KEY=dev_secret_screening_token_2026

# Fallback & Response Deadlines (milliseconds)
# Android telecom service has a ~5s deadline; backend must reply within this budget
LLM_TIMEOUT_MS=2200
FAST_RULES_TIMEOUT_MS=100
